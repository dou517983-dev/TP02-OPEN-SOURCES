@charset "utf-8";

.el-input__inner, .el-textarea__inner { box-sizing: border-box; }

[dir] .el-input__inner, [dir] .el-textarea__inner { background-image: none; transition: border-color 0.2s cubic-bezier(0.645, 0.045, 0.355, 1); }

.el-textarea { position: relative; display: inline-block; width: 100%; vertical-align: bottom; font-size: 14px; }

.el-textarea__inner { display: block; resize: vertical; line-height: 1.5; box-sizing: border-box; width: 100%; font-size: inherit; color: rgb(96, 98, 102); transition: border-color 0.2s cubic-bezier(0.645, 0.045, 0.355, 1); }

[dir] .el-textarea__inner { padding: 5px 15px; background-color: rgb(255, 255, 255); border: 1px solid rgb(220, 223, 230); border-radius: 4px; }

.el-textarea__inner::placeholder { color: rgb(192, 196, 204); }

[dir] .el-textarea__inner:hover { border-color: rgb(192, 196, 204); }

.el-textarea__inner:focus { outline: 0px; }

[dir] .el-textarea__inner:focus { border-color: rgb(64, 158, 255); }

.el-textarea .el-input__count { color: rgb(144, 147, 153); position: absolute; font-size: 12px; bottom: 5px; }

[dir] .el-textarea .el-input__count { background: rgb(255, 255, 255); }

[dir="ltr"] .el-textarea .el-input__count { right: 10px; }

[dir="rtl"] .el-textarea .el-input__count { left: 10px; }

.el-textarea.is-disabled .el-textarea__inner { color: rgb(192, 196, 204); }

[dir] .el-textarea.is-disabled .el-textarea__inner { background-color: rgb(245, 247, 250); border-color: rgb(228, 231, 237); cursor: not-allowed; }

.el-textarea.is-disabled .el-textarea__inner::placeholder { color: rgb(192, 196, 204); }

[dir] .el-textarea.is-exceed .el-textarea__inner { border-color: rgb(245, 108, 108); }

.el-textarea.is-exceed .el-input__count { color: rgb(245, 108, 108); }

.el-input { position: relative; font-size: 14px; display: inline-block; width: 100%; }

.el-input::-webkit-scrollbar { z-index: 11; width: 6px; }

.el-input::-webkit-scrollbar:horizontal { height: 6px; }

.el-input::-webkit-scrollbar-thumb { width: 6px; }

[dir] .el-input::-webkit-scrollbar-thumb { border-radius: 5px; background: rgb(180, 188, 204); }

[dir] .el-input::-webkit-scrollbar-corner, [dir] .el-input::-webkit-scrollbar-track { background: rgb(255, 255, 255); }

.el-input::-webkit-scrollbar-track-piece { width: 6px; }

[dir] .el-input::-webkit-scrollbar-track-piece { background: rgb(255, 255, 255); }

.el-input .el-input__clear { color: rgb(192, 196, 204); font-size: 14px; transition: color 0.2s cubic-bezier(0.645, 0.045, 0.355, 1); }

[dir] .el-input .el-input__clear { cursor: pointer; transition: color 0.2s cubic-bezier(0.645, 0.045, 0.355, 1); }

.el-input .el-input__clear:hover { color: rgb(144, 147, 153); }

.el-input .el-input__count { height: 100%; display: inline-flex; align-items: center; color: rgb(144, 147, 153); font-size: 12px; }

