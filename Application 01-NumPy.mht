html[dir="ltr"] { --kd-animation-fade-in-right: fadeInRight-ltr 0.2s; --kd-animation-bounce-in: bounceIn 0.3s 1; }

html[dir="ltr"], html[dir="rtl"] { --kd-animation-fade-in-down: fadeInDown 0.2s; --kd-animation-fade-out-up: fadeOutUp 0.2s; --kd-animation-fade-in-up: fadeInUp 0.2s; --kd-animation-fade-scaleY-in: fadeScaleYIn 0.2s; }

html[dir="rtl"] { --kd-animation-fade-in-right: fadeInRight-rtl 0.2s; --kd-animation-bounce-in: bounceIn 0.3s 1; }

@-webkit-keyframes fadeInDown { 
  0% { opacity: 0; transform: translate3d(0px, -50%, 0px); }
  100% { opacity: 1; }
}

@keyframes fadeInDown { 
  0% { opacity: 0; transform: translate3d(0px, -50%, 0px); }
  100% { opacity: 1; }
}

@-webkit-keyframes fadeOutUp { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0px, -5px, 0px); }
}

@keyframes fadeOutUp { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0px, -5px, 0px); }
}

@-webkit-keyframes fadeInUp { 
  0% { opacity: 0; transform: translate3d(0px, 100%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeInUp { 
  0% { opacity: 0; transform: translate3d(0px, 100%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes fadeInRight-ltr { 
  0% { opacity: 0; transform: translate3d(-100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeInRight-ltr { 
  0% { opacity: 0; transform: translate3d(-100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes fadeInRight-rtl { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeInRight-rtl { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@-webkit-keyframes fadeScaleYIn { 
  0% { opacity: 0; transform: scaleY(0.8); }
  100% { opacity: 1; transform: scaleY(1); }
}

@keyframes fadeScaleYIn { 
  0% { opacity: 0; transform: scaleY(0.8); }
  100% { opacity: 1; transform: scaleY(1); }
}

@-webkit-keyframes bounceIn { 
  0%, 20%, 40%, 60%, 80%, 100% { animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }
  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
  100% { opacity: 1; transform: scaleX(1); }
}

@keyframes bounceIn { 
  0%, 20%, 40%, 60%, 80%, 100% { animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }
  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
  100% { opacity: 1; transform: scaleX(1); }
}

.kd-icon { display: inline-block; color: inherit; font-style: normal; line-height: 0; text-transform: none; text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; font-size: 16px; }

[dir] .kd-icon { text-align: center; }

[dir="ltr"] .kd-icon-spin svg { animation: 1s linear 0s infinite normal none running kd-icon-spin-ltr; }

[dir="rtl"] .kd-icon-spin svg { animation: 1s linear 0s infinite normal none running kd-icon-spin-rtl; }

@keyframes kd-icon-spin-ltr { 
  100% { transform: rotate(1turn); }
}

@keyframes kd-icon-spin-rtl { 
  100% { transform: rotate(-1turn); }
}

@-webkit-keyframes kd-icon-spin-ltr { 
  100% { transform: rotate(1turn); }
}

@-webkit-keyframes kd-icon-spin-rtl { 
  100% { transform: rotate(-1turn); }
}

.format-icon .format-icon-file { width: 100%; height: 100%; }

.format-icon i.kd-icon { position: relative; }

[dir] .format-icon i.kd-icon { margin: 0px !important; padding: 0px !important; }

.format-icon i.kd-icon svg { width: 100% !important; height: 100% !important; }

.format-icon { position: relative; display: flex; justify-content: center; align-items: center; }

.format-icon i.kd-icon.kd-icon-shortcut { min-width: 8px; position: absolute; bottom: 0px; color: var(--kd-color-icon-primary); width: 33.3333% !important; }

[dir="ltr"] .format-icon i.kd-icon.kd-icon-shortcut { left: 0px; }

[dir="rtl"] .format-icon i.kd-icon.kd-icon-shortcut { left: auto; right: 0px; }

.k-icon { width: 1em; height: 1em; vertical-align: -0.15em; overflow: hidden; }

